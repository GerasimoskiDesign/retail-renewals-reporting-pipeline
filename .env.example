# Copy to .env and adjust. All values below are dummy demo values for the local mock portals.

# Mock BI portal (5 daily reports)
BI_PORTAL_URL=http://127.0.0.1:8701/bi
BI_PORTAL_USER=bi.demo
BI_PORTAL_PASSWORD=change-me-bi

# Mock CRM portal (1 daily report)
CRM_PORTAL_URL=http://127.0.0.1:8701/crm
CRM_PORTAL_USER=crm.demo
CRM_PORTAL_PASSWORD=change-me-crm

# Port used by `python -m renewals mock-portal`
MOCK_PORTAL_PORT=8701

# Where `--real` downloads go (in production this would be a shared drive)
REAL_DOWNLOAD_DIR=./share/downloads
